# Flytrap v0.2 — placeholders only. Do not put real secrets in the repository.
# Copy to .env (gitignored) or inject via the process environment / a mount.

NODE_ENV=development
# Comma-separated. v0.2 runs all three in one process.
ROLES=smtp,worker,api

# Raw EML, attachments, and SQLite live here. Not in the repo.
MAIL_DATA_DIR=./data

# Required. Lowercase domains, no wildcards. Refuse to start if empty or invalid.
ACCEPT_DOMAINS=example.com,example.net,example.org

SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_BANNER=mx.example.com
SMTP_MAX_BYTES=20971520
# Both empty = plaintext only. Both set = advertise STARTTLS. One of them = refuse to start.
SMTP_TLS_KEY_FILE=
SMTP_TLS_CERT_FILE=

# Connection policy. Exceeding any of these returns 421.
SMTP_MAX_CONN_PER_IP=10
SMTP_MAX_CONN_PER_MIN=60
SMTP_MAX_DATA_PER_HOUR=120

# Default binds loopback. In Docker, listen on 0.0.0.0 and publish 127.0.0.1:8080 on the host.
API_HOST=127.0.0.1
API_PORT=8080
API_USERNAME=admin
# Required to boot the api role. No default password.
API_PASSWORD=
# Required to boot the api role. At least 32 characters. No default secret.
SESSION_SECRET=

# openai-compat classifier. Required when ROLES includes worker and CLASSIFIER=openai-compat.
CLASSIFIER=openai-compat
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Directory of versioned prompts. Default: <repo>/prompts. Mount over this in production.
PROMPTS_DIR=

# Notifiers. Leave unset to archive without pushing.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_BEARER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_LABELS=phish,malware
NOTIFY_MIN_CONFIDENCE=0.6
# Deep link prefix. Default http://API_HOST:API_PORT
PANEL_BASE_URL=

# auto = try zstd, fall back to gzip if the native addon cannot load.
# zstd = fail startup if the addon cannot load. gzip = node:zlib.
COMPRESS=auto

# 0 disables the disk-usage warning. Bytes of MAIL_DATA_DIR, warn only, never delete.
DISK_ALERT_BYTES=0

# Optional one-shot import: node dist/main.js --import-history ./history.json
LOG_LEVEL=info
WORKER_POLL_MS=1000
