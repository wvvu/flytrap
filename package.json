{
  "name": "flytrap",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/api/public', 'dist/api/public', { recursive: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.1",
    "@mongodb-js/zstd": "^2.0.1",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "mailauth": "^4.8.1",
    "pino": "^10.0.0",
    "postal-mime": "^2.5.0",
    "smtp-server": "^3.15.0",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/smtp-server": "^3.5.11",
    "nodemailer": "^7.0.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
